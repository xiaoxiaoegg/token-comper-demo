      "category": "ultra",
      "minIntensity": "ultra",
      "description": "删 based on 冗余"
    },
    {
      "name": "en_ultra_which_removal",
      "pattern": "\\b(?:which ones|which)\\s+",
      "replacement": "",
      "context": "system",
      "category": "ultra",
      "minIntensity": "ultra",
      "description": "删 which 引导冗余"
    },
    {
      "name": "en_ultra_at_least",
      "pattern": "\\b(?:at least)\\b\\s*",
      "replacement": "",
      "context": "system",
      "category": "ultra",
      "minIntensity": "ultra",
      "description": "at least→删"
